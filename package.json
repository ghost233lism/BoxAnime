{
  "name": "box-anime",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:demo": "tsx scripts/generate-demo.ts",
    "verify:demo": "tsx scripts/generate-demo.ts --verify",
